    {
      "name": "25e99333",
      "displayName": "cross_city_feature_imp_query",
      "queryLines": [
        "SELECT \n",
        "  feature,\n",
        "  toronto_mean_abs_shap AS mean_shap,\n",
        "  'Toronto' AS city\n",
        "FROM cross_city_shap\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT \n",
        "  feature,\n",
        "  nyc_mean_abs_shap AS mean_shap,\n",
        "  'NYC' AS city\n",
        "FROM cross_city_shap"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
