    {
      "name": "b517c9b7",
      "displayName": "city hazard ratios with confidence interval margins",
      "queryLines": [
        "SELECT \r\n",
        "    city,\r\n",
        "    interpretation,\r\n",
        "    hr,\r\n",
        "    ci_lower,\r\n",
        "    ci_upper,\r\n",
        "    -- Calculate the distance from the HR to the upper bound\r\n",
        "    (ci_upper - hr) AS error_margin\r\n",
        "FROM workspace.default.demand_hr_table_toronto_nyc"
      ]
    },
    {
      "name": "cd40467b",
      "displayName": "Logrank Summary Within City",
      "queryLines": [
        "SELECT \r\n",
        "  city, \r\n",
        "  stratification, \r\n",
        "  ROUND(p_value, 4) AS p_value, \r\n",
        "  significant, \r\n",
        "  higher_risk_group_tail \r\n",
        "FROM \r\n",
        "  workspace.default.logrank_summary"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
