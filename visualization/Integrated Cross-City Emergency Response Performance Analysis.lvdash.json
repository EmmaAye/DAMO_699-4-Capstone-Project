{
  "datasets": [
    {
      "name": "b82b9527",
      "displayName": "nyc_model_ready",
      "queryLines": [
        "SELECT * FROM workspace.capstone_project.nyc_model_ready"
      ]
    },
    {
      "name": "25a85096",
      "displayName": "toronto_model_ready",
      "queryLines": [
        "SELECT * FROM workspace.capstone_project.toronto_model_ready"
      ]
    },
    {
      "name": "ac05473d",
      "displayName": "combined_model_ready",
      "queryLines": [
        "SELECT * FROM workspace.capstone_project.combined_model_ready\r\n",
        "-- SELECT DISTINCT city\r\n",
        "-- FROM workspace.capstone_project.combined_model_ready\r\n",
        "-- ORDER BY city"
      ],
      "columns": [
        {
          "displayName": "hazard_ratio",
          "description": "Hazard ratio for each city: compares delay_indicator (events) to event_indicator (total at-risk incidents).",
          "expression": "TRY_DIVIDE(SUM(delay_indicator), SUM(event_indicator))"
        },
        {
          "displayName": "delay_rate_percent",
          "description": "Delay rate as a proportion of delayed incidents per city (SUM(delay_indicator) / COUNT(*))",
          "expression": "TRY_DIVIDE(SUM(delay_indicator), COUNT(*))"
        },
        {
          "displayName": "censored_incidents",
          "description": "Number of censored incidents (response_minutes is NULL)",
          "expression": "SUM(CASE WHEN response_minutes IS NULL THEN 1 ELSE 0 END)"
        },
        {
          "displayName": "censor_rate_percent",
          "description": "Censor rate as percent of censored incidents (SUM(CASE WHEN response_minutes IS NULL THEN 1 ELSE 0 END) / COUNT(*) * 100)",
          "expression": "TRY_MULTIPLY(TRY_DIVIDE(SUM(CASE WHEN response_minutes IS NULL THEN 1 ELSE 0 END), COUNT(*)), 100)"
        },
        {
          "displayName": "prob_exceed_8min_delay",
          "description": "Probability to exceed 8 minute delay threshold for each city.",
          "expression": "TRY_DIVIDE(SUM(CASE WHEN response_minutes > 8 THEN 1 ELSE 0 END), COUNT(*))"
        }
      ]
    },
    {
      "name": "268ebafb",
      "displayName": "Median Response Time by City",
      "queryLines": [
        "SELECT\n",
        "  city,\n",
        "  APPROX_PERCENTILE(response_minutes, 0.5) AS median_response_time\n",
        "FROM\n",
        "  workspace.capstone_project.combined_model_ready\n",
        "GROUP BY\n",
        "  city"
      ],
      "catalog": "workspace",
      "schema": "capstone_project"
    },
    {
      "name": "50688811",
      "displayName": "mean_med_p90_p95",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    AVG(response_minutes) AS mean_response,\r\n",
        "    percentile_approx(response_minutes, 0.5) AS median_response,\r\n",
        "    percentile_approx(response_minutes, 0.9) AS p90_response,\r\n",
        "    percentile_approx(response_minutes, 0.95) AS p95_response\r\n",
        "FROM workspace.capstone_project.combined_model_ready\r\n",
        "GROUP BY city\r\n",
        "ORDER BY city"
      ]
    },
    {
      "name": "213baf17",
      "displayName": "City Incident Response Delay Summary",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    COUNT(*) AS total_incidents,\r\n",
        "    SUM(CASE WHEN response_minutes > 8 THEN 1 ELSE 0 END) AS delayed_incidents,\r\n",
        "    SUM(CASE WHEN response_minutes > 8 THEN 1 ELSE 0 END) * 1.0 / COUNT(*) AS delay_rate\r\n",
        "FROM workspace.capstone_project.combined_model_ready\r\n",
        "GROUP BY city"
      ]
    },
    {
      "name": "27971290",
      "displayName": "Complete_response_time",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    FLOOR(response_minutes) AS response_bin,\r\n",
        "    COUNT(*) AS incident_count\r\n",
        "FROM workspace.capstone_project.combined_model_ready\r\n",
        "WHERE response_minutes BETWEEN 0 AND 60\r\n",
        "GROUP BY city, FLOOR(response_minutes)\r\n",
        "ORDER BY response_bin"
      ]
    },
    {
      "name": "4deb9daa",
      "displayName": "response_delay_pct",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    AVG(CASE WHEN response_minutes > 8 THEN 1 ELSE 0 END) * 100 AS response_gt_8min_pct,\r\n",
        "    AVG(CASE WHEN response_minutes > 10 THEN 1 ELSE 0 END) * 100 AS response_gt_10min_pct,\r\n",
        "    AVG(CASE WHEN response_minutes > 15 THEN 1 ELSE 0 END) * 100 AS response_gt_15min_pct\r\n",
        "FROM workspace.capstone_project.combined_model_ready\r\n",
        "GROUP BY city"
      ]
    },
    {
      "name": "6d336bea",
      "displayName": "SLA_breach_pct",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    AVG(CASE WHEN response_minutes > 5 THEN 1 ELSE 0 END) * 100 AS response_gt_5min_pct,\r\n",
        "    AVG(CASE WHEN response_minutes > 8 THEN 1 ELSE 0 END) * 100 AS response_gt_8min_pct\r\n",
        "FROM workspace.capstone_project.combined_model_ready\r\n",
        "GROUP BY city"
      ]
    },
    {
      "name": "a5fa88a6",
      "displayName": "SLA_Breach_Long_Format",
      "queryLines": [
        "SELECT\n",
        "  city,\n",
        "  '5min' AS threshold,\n",
        "  AVG(\n",
        "    CASE\n",
        "      WHEN response_minutes > 5 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )AS breach_pct\n",
        "FROM\n",
        "  workspace.capstone_project.combined_model_ready\n",
        "GROUP BY\n",
        "  city\n",
        "UNION ALL\n",
        "SELECT\n",
        "  city,\n",
        "  '8min' AS threshold,\n",
        "  AVG(\n",
        "    CASE\n",
        "      WHEN response_minutes > 8 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )AS breach_pct\n",
        "FROM\n",
        "  workspace.capstone_project.combined_model_ready\n",
        "GROUP BY\n",
        "  city"
      ]
    },
    {
      "name": "50deb195",
      "displayName": "Threshold_Exceedance",
      "queryLines": [
        "SELECT city, '8 min' AS threshold,\n",
        "       AVG(CASE WHEN response_minutes > 8 THEN 1 ELSE 0 END) AS exceed_pct\n",
        "FROM workspace.capstone_project.combined_model_ready\n",
        "GROUP BY city\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT city, '10 min',\n",
        "       AVG(CASE WHEN response_minutes > 10 THEN 1 ELSE 0 END)\n",
        "FROM workspace.capstone_project.combined_model_ready\n",
        "GROUP BY city\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT city, '15 min',\n",
        "       AVG(CASE WHEN response_minutes > 15 THEN 1 ELSE 0 END)\n",
        "FROM workspace.capstone_project.combined_model_ready\n",
        "GROUP BY city"
      ]
    }
  ],
